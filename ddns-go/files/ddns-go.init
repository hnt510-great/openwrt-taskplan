START=99

# The native manager owns the daemon. rc.d remains for recovery boots.
if [ -z "$IPKG_INSTROOT" ] && [ -d /run/systemd/system ] &&
   [ -f /usr/lib/systemd/system/ddns-go.service ]; then
	case "$action" in
		boot|shutdown) exit 0 ;;
		help|depends) ;;
		*) exec /usr/libexec/ddns-go-systemd "$action" "$@" ;;
	esac
fi

USE_PROCD=1
NAME=ddns-go
PROG=/usr/bin/ddns-go
. "$IPKG_INSTROOT/usr/libexec/ddns-go-config.sh"

start_instance() {
	local cfg="$1"
	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" -eq 0 ] && return 0

	config_get delay "$cfg" delay 0
	if [ "$delay" -gt 0 ]; then
		local uptime
		uptime=$(awk -F. '{print $1}' /proc/uptime)
		[ "$uptime" -lt 120 ] && sleep "$delay"
	fi

	ddns_go_init_yaml

	local args
	args=$(ddns_go_build_args "$cfg")

	procd_open_instance
	# shellcheck disable=SC2086
	procd_set_param command $PROG $args

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param log_level 7

	procd_set_param user ddns-go
	procd_set_param respawn

	procd_close_instance
}

start_service() {
	config_load "$NAME"
	config_foreach start_instance 'basic'
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}
